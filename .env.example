# Copie este arquivo para ".env" e preencha com os dados do seu banco.
# Em produção (Render), NÃO use um arquivo .env — configure essas mesmas
# variáveis direto no painel do Render em "Environment".

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_usuarios

# Coloque "true" se o banco exigir SSL (ex: TiDB Cloud, PlanetScale, Aiven)
DB_SSL=false

PORT=3000
